# Copy this file to .env and fill in the values you need.
# Nothing here is committed - .env is gitignored.

# --- Database ---------------------------------------------------------
# SQLite file path/URL. In Docker this should point at a path inside the
# mounted volume (see docker-compose.yml), e.g. file:/app/data/production.db
DATABASE_URL="file:./dev.db"

# --- LM Studio / default LLM connection --------------------------------
# Used as the "Server-Standard" fallback whenever a role (Primary Model /
# Embedding Model) has no explicit provider selected in /admin/einstellungen.
# When running in Docker with LM Studio on the host machine, use:
#   http://host.docker.internal:1234/v1   (Docker Desktop / Mac / Windows)
# On Linux hosts, add `extra_hosts: ["host.docker.internal:host-gateway"]`
# to docker-compose.yml, or use the host's LAN IP directly.
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL="local-model"
LMSTUDIO_EMBEDDING_MODEL="text-embedding-nomic-embed-text-v1.5"

# Additional cloud providers (OpenAI, OpenRouter, Ollama, ...) are NOT
# configured via env vars - add them in /admin/einstellungen. API keys are
# stored in plaintext in the database.

# --- Article generation timeouts (ms, optional) ------------------------
ARTICLE_GENERATION_TIMEOUT_MS=600000
RESEARCH_AI_TIMEOUT_MS=1800000

# --- Web search (used by the research pipeline) -------------------------
BRAVE_SEARCH_API_KEY=

# --- SMTP / Newsletter ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=

# --- FILMRADAR comparison tool -------------------------------------------
FILMRADAR_CMS_BASE_URL=
FILMRADAR_CMS_USER=
FILMRADAR_CMS_PASSWORD=
OMDB_API_KEY=
FILMRADAR_REFRESH_INTERVAL_HOURS=

# --- Misc -----------------------------------------------------------------
# Public site URL, used to build absolute links in the newsletter.
SITE_URL="http://localhost:3000"
# Shared secret required by /api/cron to trigger scheduled jobs externally.
CRON_SECRET=
RESEARCH_SOURCE_PRESET=
RESEARCH_FOCUS_TOPICS=
RESEARCH_PRIMARY_DOMAIN=
